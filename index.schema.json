{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VlHash/miwifi-extension-framework/plugins/index.schema.json",
  "title": "MWEF Online Plugin Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "maintainer",
    "updated",
    "plugins"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/VlHash/miwifi-extension-framework/plugins/index.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "maintainer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "plugins": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-CN"],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "permission": {
      "type": "string",
      "enum": [
        "system.read",
        "filesystem.read",
        "filesystem.write",
        "network.client",
        "service.control",
        "shell.execute"
      ]
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$",
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "version",
        "author",
        "license",
        "mwef",
        "permissions",
        "archive",
        "homepage",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,31}$"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "mwef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "archive": {
          "$ref": "#/$defs/archive"
        },
        "homepage": {
          "type": "string",
          "pattern": "^https://\\S+$",
          "maxLength": 512
        },
        "source": {
          "type": "string",
          "pattern": "^https://\\S+$",
          "maxLength": 512
        },
        "published": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "changelog": {
          "type": "string",
          "pattern": "^https://\\S+$",
          "maxLength": 512
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          }
        }
      }
    }
  }
}
